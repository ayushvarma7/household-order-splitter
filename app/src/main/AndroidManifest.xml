<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      SPEC 4.10 and PROMPT hard rule 8: this app declares no network permission at all.
      SPEC 1.5: offline, single-user, single-device.

      Removed rather than merely not requested. ML Kit's own manifest declares INTERNET so
      that its unbundled variant can download models, and a merged manifest would inherit
      it. This build uses the bundled text recogniser, whose model ships inside the APK, so
      recognition works with no network whatever. Stripping the permission here is what
      makes the claim in the README and on the Settings screen literally true of the
      shipped manifest rather than true of our own intentions.

      Verify it by dumping the built APK's manifest with aapt2 and grepping for
      permission: the shipped app declares none at all.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".SplitterApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.HouseholdSplitter">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HouseholdSplitter.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- SPEC 8.1.2: the share target. Screenshot the Walmart app, share it here. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Long-press the launcher icon: the two things a household opens the app
                 to do. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The balances widget. exported="false" would stop the launcher binding to it. -->
        <receiver
            android:name=".widget.BalancesWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_balances_info" />
        </receiver>

        <!-- The quick actions widget: three buttons, no database read. -->
        <receiver
            android:name=".widget.QuickActionsWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>

        <!--
          Asked once, when a balances widget is placed: which group should it show?

          exported="true" is required rather than careless. The launcher starts this
          activity on the user's behalf when they drop the widget, and it is a different
          app, so a configuration activity that is not exported is simply never launched and
          the widget can never be placed at all.
        -->
        <activity
            android:name=".widget.BalancesWidgetConfigureActivity"
            android:exported="true"
            android:label="@string/widget_configure_title"
            android:theme="@style/Theme.HouseholdSplitter">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          The quick settings tile. Reachable from the lock screen shade on every device from
          Android 7 up, which is what makes it the dependable half of the lock screen story
          while keyguard widgets remain a moving target.

          BIND_QUICK_SETTINGS_TILE is a permission the system holds, not one this app
          requests: it is how the system proves to itself that only it may bind this
          service, and it does not appear on the app's own permission list. The shipped
          manifest still declares no permissions at all.
        -->
        <service
            android:name=".widget.ScanBillTileService"
            android:exported="true"
            android:icon="@drawable/ic_shortcut_new_order"
            android:label="@string/tile_scan_bill"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- SPEC 7.4.3: the camera capture is written to our own cache and shared back. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
