<?xml version="1.0" encoding="utf-8"?>
<!--
  The translucent plate behind an introduction illustration. White at low alpha over the
  gradient, with a slightly brighter edge, so it reads as a pane of frosted glass rather
  than as a second block of colour that would have to be kept in step with the palette.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#26FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <corners android:radius="@dimen/welcome_plate_radius" />
</shape>
