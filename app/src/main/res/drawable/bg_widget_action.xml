<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's action pill. A flat fill rather than a ripple, because RemoteViews on an
     older launcher will not draw a state list reliably and a button that looks pressed and
     is not is worse than one that never appears to react. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_action" />
    <corners android:radius="20dp" />
</shape>
