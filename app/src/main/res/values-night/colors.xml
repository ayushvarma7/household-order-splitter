<?xml version="1.0" encoding="utf-8"?>
<!--
  The dark palette. Same semantic names, different hues, so no layout and no Java changes.

  SPEC 11.8 makes the point for screenshots and it holds for the app too: nothing may depend
  on an absolute colour value. Containers become dark and their "on" colours become light,
  which is why every usage refers to a pair rather than to a single colour.
-->
<resources>

    <color name="primary">#B8C3FF</color>
    <color name="on_primary">#092B7A</color>
    <color name="primary_container">#264192</color>
    <color name="on_primary_container">#DDE1FF</color>

    <color name="secondary">#C3C5DD</color>
