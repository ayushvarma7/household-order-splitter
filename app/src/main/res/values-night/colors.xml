<?xml version="1.0" encoding="utf-8"?>
<!--
  The dark palette. Same semantic names, its own steps, so no layout and no Java changes.

  Chosen rather than flipped. The member colours in particular are searched against the
  dark surface on their own, because lifting the light ones by hue collapses distinct
  entries into near-duplicates: two magentas that read apart at L 0.45 are the same colour
  at L 0.63.

  SPEC 11.8 makes the point for screenshots and it holds for the app too: nothing may depend
  on an absolute colour value. Containers become dark and their "on" colours become light,
  which is why every usage refers to a pair rather than to a single colour.
-->
<resources>

    <color name="primary">#D3BBFF</color>
    <color name="on_primary">#3B1E75</color>
    <color name="primary_container">#52368F</color>
    <color name="on_primary_container">#EBDCFF</color>

    <color name="secondary">#CBC2DB</color>
    <color name="on_secondary">#332D41</color>
    <color name="secondary_container">#4A4458</color>
    <color name="on_secondary_container">#E7DEF8</color>

    <color name="tertiary">#EFB8C8</color>
    <color name="on_tertiary">#4A2532</color>
    <color name="tertiary_container">#633B48</color>
    <color name="on_tertiary_container">#FFD8E4</color>

    <color name="surface">#141218</color>
    <color name="on_surface">#E6E0E9</color>
    <color name="surface_variant">#49454F</color>
    <color name="on_surface_variant">#CAC4CF</color>
    <color name="surface_container_lowest">#0F0D13</color>
    <color name="surface_container_low">#1D1A22</color>
    <color name="surface_container">#211E26</color>
    <color name="surface_container_high">#2B2830</color>
    <color name="outline">#948F99</color>
    <color name="outline_variant">#49454F</color>
    <color name="scrim">#000000</color>
    <color name="inverse_surface">#E6E0E9</color>
    <color name="inverse_on_surface">#322F35</color>

    <color name="error">#FFB4AB</color>
    <color name="on_error">#690005</color>
    <color name="error_container">#93000A</color>
    <color name="on_error_container">#FFDAD6</color>

    <color name="success">#8FD9B2</color>
    <color name="on_success">#00391F</color>
    <color name="success_container">#0B5235</color>
    <color name="on_success_container">#B8F2D2</color>
    <color name="warning">#F3C05A</color>
    <color name="on_warning">#412A00</color>
    <color name="warning_container">#5D3F00</color>
    <color name="on_warning_container">#FFDEB0</color>
    <color name="danger">#FFB4AB</color>
    <color name="danger_container">#93000A</color>
    <color name="on_danger_container">#FFDAD6</color>

    <!--
      Searched against #141218 on its own terms, and passing all five categorical checks:
      lightness band, chroma floor, colour-vision separation (worst adjacent dE 13.7),
      normal-vision separation (16.1) and contrast. Every entry carries the dark ink below
      at 4.50:1 or better.
    -->
    <color name="member_1">#F05A66</color>
    <color name="member_2">#309CEA</color>
    <color name="member_3">#E46096</color>
    <color name="member_4">#487EF6</color>
    <color name="member_5">#3C9C66</color>
    <color name="member_6">#308AC0</color>
    <color name="member_7">#4E961E</color>
    <color name="member_8">#00A2B4</color>
    <color name="member_9">#E4600C</color>
    <color name="member_10">#00968A</color>

    <!-- Dark ink, because the lifted member colours are too light to carry white. -->
    <color name="on_member_avatar">#1C1B1F</color>

    <!-- Same in both palettes; see the light file for why. -->
    <color name="viewer_backdrop">#000000</color>
    <color name="viewer_foreground">#FFFFFF</color>

    <!-- The widget cannot use theme attributes: RemoteViews are inflated by the launcher,
         not the app, so its colours are resolved against the launcher's theme. -->
    <color name="widget_background">#FF211E26</color>
    <color name="widget_title">#FFCBC2DB</color>
    <color name="widget_body">#FFE6E0E9</color>

    <color name="welcome_dot_inactive">#33FFFFFF</color>

    <!-- The same two identities, lightened for the dark card: 10.1:1 and 10.3:1. -->
    <color name="store_walmart">#A6C8FF</color>
    <color name="store_amazon_fresh">#A9D673</color>
    <color name="store_restaurant">#00C0C4</color>

    <!-- The widget's scan action: a tinted pill, readable on the widget's own background. -->
    <color name="widget_action">#33D3BBFF</color>
    <color name="widget_action_text">#D3BBFF</color>

</resources>
