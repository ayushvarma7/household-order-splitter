<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Dark mode, as a difference rather than a copy.

      Every colour role already points at an @color name, and those resolve from
      values-night on their own, so there is nothing to restate here. What is left is the
      one thing a colour resource cannot express: the system bars draw their icons dark on
      a light scheme and light on a dark one, and that is a boolean, not a colour.

      This file used to redeclare the whole theme. See the comment on
      Theme.HouseholdSplitter in values/themes.xml for what that cost.
    -->
    <style name="Theme.HouseholdSplitter" parent="Base.Theme.HouseholdSplitter">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
