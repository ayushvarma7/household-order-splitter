<?xml version="1.0" encoding="utf-8"?>
<!--
  The type scale, restated on Inter.

  Restated rather than re-pointed, because a scale is tuned to a typeface and Material's is
  tuned to Roboto. Inter has a larger x-height and wider default spacing, so Roboto's
  tracking leaves it loose and slightly juvenile at every size above body text. The figures
  below run negative at display sizes and positive at caption sizes, which is the ordinary
  rule: large text needs pulling together and small text needs opening up.

  Sizes are a little tighter than Material's defaults for the same reason. Inter at 21sp
  reads about the size Roboto does at 24, so a headline that matched Material's number
  would look shouty next to the same content in the old type.

  Every one of these is wired to a theme attribute below, so a Material component that asks
  for textAppearanceTitleMedium gets Inter without being told about it individually.
-->
<resources>

    <style name="TextAppearance.Splitter.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
    </style>

    <style name="TextAppearance.Splitter.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.022</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Splitter.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.18</item>
    </style>

    <style name="TextAppearance.Splitter.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.Splitter.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.017</item>
        <item name="android:lineSpacingMultiplier">1.22</item>
    </style>

    <style name="TextAppearance.Splitter.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">-0.014</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Splitter.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.28</item>
    </style>

    <style name="TextAppearance.Splitter.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="TextAppearance.Splitter.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.Splitter.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <style name="TextAppearance.Splitter.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.004</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
    </style>

    <style name="TextAppearance.Splitter.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.Splitter.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.Splitter.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.012</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.Splitter.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.016</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!--
      Money, set apart from the text scale on purpose.

      Tabular figures, so a column of amounts lines up digit under digit and a $9.00 beside
      a $19.00 does not shuffle the decimal point sideways. Inter carries tnum, which is
      most of why it is here.

      Slightly tighter tracking than the text at the same size: figures are already evenly
      spaced by the tabular feature, and the default tracking on top of that reads as gappy.
    -->
    <style name="TextAppearance.Splitter.Money" parent="TextAppearance.Splitter.TitleMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Splitter.MoneyLarge" parent="TextAppearance.Splitter.HeadlineSmall">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">21sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Splitter.MoneySmall" parent="TextAppearance.Splitter.BodyMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

</resources>
