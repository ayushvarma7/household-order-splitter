<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      SPEC 4.3: Material Components, Material 3.

      Every colour role is mapped explicitly rather than left to the default baseline, so a
      Material component and a hand-written view resolve to the same palette, and so the
      night variant is a colour swap with no theme duplication.
    -->
    <style name="Theme.HouseholdSplitter" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>

        <!--
          Typography, mapped attribute by attribute rather than by setting a font on the
          theme and hoping.

          A theme level android:fontFamily does not reach a Material component, because
          every Material text appearance names its own family and wins. Pointing each of
          the fifteen attributes at a restated style is what makes a button, a toolbar
          title, a text field label and a snackbar all arrive in the same typeface without
          any of them being told about it. See type.xml.
        -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Splitter.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Splitter.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Splitter.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Splitter.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Splitter.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Splitter.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Splitter.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Splitter.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Splitter.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Splitter.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Splitter.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Splitter.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Splitter.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Splitter.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Splitter.LabelSmall</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>

        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>

        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/inverse_on_surface</item>

        <!-- Edge to edge. The layouts pad themselves from the real insets, so content is
             never hidden under the status bar or the gesture bar. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <item name="shapeAppearanceCornerSmall">@style/Shape.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Large</item>
    </style>

    <style name="Shape.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/radius_s</item>
    </style>

    <style name="Shape.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/radius_m</item>
    </style>

    <style name="Shape.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/radius_l</item>
    </style>

    <!--
      The launch theme. Android draws this before the first frame, so the app opens into
      its own mark rather than a white flash. It hands over to the main theme in
      MainActivity, which is what installSplashScreen does.
    -->
    <style name="Theme.HouseholdSplitter.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/primary</item>
        <item name="postSplashScreenTheme">@style/Theme.HouseholdSplitter</item>
    </style>
</resources>
