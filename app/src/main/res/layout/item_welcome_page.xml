<?xml version="1.0" encoding="utf-8"?>
<!--
  One introduction page, drawn over the gradient the fragment paints behind the pager.

  Everything here is white or a translucent white, because the background is a deep wash of
  the active palette and is guaranteed dark enough for white to clear WCAG AA on it: see
  WelcomeGradient, which darkens the palette colour until that is true rather than assuming
  it. Nothing on this page names a colour from the palette, so a new palette needs no change
  here.

  Scrollable, so a large system font size cannot cut off the text.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="360dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/content_max_width">

            <!-- The illustration sits on a translucent plate rather than directly on the
                 gradient, which gives the icon a consistent surface to be read against
                 wherever the gradient happens to be at that point on the screen. -->
            <FrameLayout
                android:id="@+id/pagePlate"
                android:layout_width="@dimen/welcome_plate"
                android:layout_height="@dimen/welcome_plate"
                android:background="@drawable/bg_welcome_plate">

                <!-- No tint. These three are multicoloured scenes rather than interface
                     icons, and a tint would flatten every receipt, coin and card in them
                     to one colour. -->
                <ImageView
                    android:id="@+id/pageIcon"
                    android:layout_width="@dimen/welcome_illustration"
                    android:layout_height="@dimen/welcome_illustration"
                    android:layout_gravity="center"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:gravity="center_horizontal"
                android:textAppearance="@style/Text.Display"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/pageBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:alpha="0.85"
                android:gravity="center_horizontal"
                android:textAppearance="@style/Text.Body"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
