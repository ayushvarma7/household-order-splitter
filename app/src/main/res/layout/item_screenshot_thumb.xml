<?xml version="1.0" encoding="utf-8"?>
<!-- SPEC 7.12.2: a thumbnail of an original screenshot, tappable to view full screen. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/thumbnail_size"
    android:layout_height="@dimen/thumbnail_size"
    android:layout_marginEnd="@dimen/space_s"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_m"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/stroke_width">

    <!-- The card carries the description ("Screenshot 2"), so the image itself stays out
         of the accessibility tree rather than announcing the same thing twice. -->
    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainerHigh"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_xxs"
        android:scaleType="fitCenter" />

    <!--
      The number, on the picture.

      It was only ever in the accessibility description and in the viewer's title, which is
      to say it was readable once you had already opened the one you wanted. The app now
      asks which photo a missed row was on, and that question is unanswerable unless the
      pictures are numbered where they are being looked at.

      Bottom left, on a pill, because a till receipt photographed upright puts its text up
      the middle and its edge down the sides.
    -->
    <TextView
        android:id="@+id/thumbNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="@dimen/space_xs"
        android:background="@drawable/bg_thumb_number"
        android:importantForAccessibility="no"
        android:minWidth="22dp"
        android:paddingStart="@dimen/space_xs"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_xs"
        android:paddingBottom="2dp"
        android:textAppearance="@style/Text.Caption"
        android:textColor="?attr/colorOnPrimary" />
</com.google.android.material.card.MaterialCardView>
