<?xml version="1.0" encoding="utf-8"?>
<!-- One choice on the widget configuration screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_m"
    android:paddingBottom="@dimen/space_m">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/choiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.Body" />

        <TextView
            android:id="@+id/choiceDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.Caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Tinted, because ic_check_circle is a filled white glyph with no colour of its own
         and an untinted one is invisible on a white card. -->
    <ImageView
        android:id="@+id/choiceTick"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="?attr/colorPrimary" />
</LinearLayout>
