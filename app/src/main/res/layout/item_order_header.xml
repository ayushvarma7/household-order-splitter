<?xml version="1.0" encoding="utf-8"?>
<!-- A month heading in the home list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xs"
    android:paddingEnd="@dimen/space_xs"
    android:paddingTop="@dimen/space_l"
    android:paddingBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Text.SectionLabel" />

    <TextView
        android:id="@+id/subheading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Text.Caption"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
