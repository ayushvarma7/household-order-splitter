<?xml version="1.0" encoding="utf-8"?>
<!-- One group in the switcher. The current one is marked with a tick as well as a colour,
     so which group you are in survives greyscale and colour blindness. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_l"
    android:paddingEnd="@dimen/space_l">

    <TextView
        android:id="@+id/groupInitial"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:textAppearance="@style/Text.Caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/groupName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/Text.Body" />

    <ImageView
        android:id="@+id/groupTick"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@string/drawer_current_group"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone" />
</LinearLayout>
