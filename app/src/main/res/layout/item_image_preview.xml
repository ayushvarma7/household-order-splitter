<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/preview_tile_width"
    android:layout_height="match_parent"
    android:layout_marginEnd="@dimen/space_s"
    app:cardCornerRadius="@dimen/radius_m"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/stroke_width">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--
          fitCenter rather than centerCrop. A screenshot is a tall, mostly white page, and
          centre-cropping it shows the blank middle, which reads as an empty tile. Fitting
          the whole page in shows the coloured app bar and the shape of the content, which
          is what tells the user which screenshot this is and therefore whether the order
          they are about to drag into is right.
        -->
        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceContainerHigh"
            android:contentDescription="@string/screenshot_preview"
            android:padding="@dimen/space_xxs"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/positionLabel"
            android:layout_width="@dimen/avatar_size_small"
            android:layout_height="@dimen/avatar_size_small"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_xs"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="?attr/colorPrimary"
            android:gravity="center"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="@dimen/avatar_text_small"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/removeButton"
            style="?attr/borderlessButtonStyle"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_gravity="top|end"
            android:contentDescription="@string/action_remove_screenshot"
            android:src="@drawable/ic_close"
            app:tint="@color/viewer_foreground" />

        <ImageView
            android:id="@+id/dragHandle"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_gravity="bottom|center_horizontal"
            android:contentDescription="@string/drag_to_reorder"
            android:padding="@dimen/space_m"
            android:src="@drawable/ic_drag"
            app:tint="@color/viewer_foreground" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
