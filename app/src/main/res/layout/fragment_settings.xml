<?xml version="1.0" encoding="utf-8"?>
<!-- S14, SPEC 7.14. Grouped into cards so a destructive action never sits next to a
     harmless one. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Splitter.Toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
        app:layout_constraintWidth_max="@dimen/content_max_width"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/menu_settings" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="@dimen/space_s"
                android:paddingBottom="@dimen/space_xxl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <!-- SPEC 7.14.1 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Splitter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_allocation"
                            android:textAppearance="@style/Text.SectionLabel" />

                        <RadioGroup
                            android:id="@+id/allocationGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/allocationProportional"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/touch_target_min"
                                android:text="@string/settings_allocation_proportional"
                                android:textAppearance="@style/Text.Body" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/allocationEqual"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/touch_target_min"
                                android:text="@string/settings_allocation_equal"
                                android:textAppearance="@style/Text.Body" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Standing rules: the household's own answers to the questions the assign
                     screen keeps asking. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Splitter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_rules"
                            android:textAppearance="@style/Text.SectionLabel" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/settings_rules_body"
                            android:textAppearance="@style/Text.Body"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/rulesCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textAppearance="@style/Text.Caption"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rulesButton"
                            style="@style/Widget.Splitter.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height_large"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/action_manage_rules" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Splitter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_theme"
                            android:textAppearance="@style/Text.SectionLabel" />

                        <RadioGroup
                            android:id="@+id/themeGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/themeSystem"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/touch_target_min"
                                android:text="@string/settings_theme_system"
                                android:textAppearance="@style/Text.Body" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/themeLight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/touch_target_min"
                                android:text="@string/settings_theme_light"
                                android:textAppearance="@style/Text.Body" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/themeDark"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/touch_target_min"
                                android:text="@string/settings_theme_dark"
                                android:textAppearance="@style/Text.Body" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SPEC 7.14.3 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Splitter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_currency"
                            android:textAppearance="@style/Text.SectionLabel" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.Splitter.TextInput"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/settings_currency_symbol">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/currencyInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLength="3" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/currencySave"
                                style="@style/Widget.Splitter.Button.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/button_height_large"
                                android:layout_marginStart="@dimen/space_s"
                                android:text="@string/action_save" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- The Excel workbook: one sheet per order, kept up to date on its own. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Splitter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_workbook"
                            android:textAppearance="@style/Text.SectionLabel" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/settings_workbook_body"
                            android:textAppearance="@style/Text.BodyMuted" />

                        <TextView
                            android:id="@+id/workbookStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textAppearance="@style/Text.Caption" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/workbookAuto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/settings_workbook_auto"
                            android:textAppearance="@style/Text.Body" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/workbookChooseButton"
                            style="@style/Widget.Splitter.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/settings_workbook_choose" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/workbookUpdateButton"
                            style="@style/Widget.Splitter.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/settings_workbook_update" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SPEC 7.14.4, 7.11.3, 9.5 -->
                <!-- Automatic backups: the data here is unrecreatable, and a manual export
                     only helps the households that remember to use it. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Splitter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_autobackup"
                            android:textAppearance="@style/Text.SectionLabel" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/settings_autobackup_body"
                            android:textAppearance="@style/Text.Body"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/autoBackupStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textAppearance="@style/Text.Caption" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/autoBackupSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/settings_autobackup_switch"
                            android:textAppearance="@style/Text.Body" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/autoBackupChooseButton"
                            style="@style/Widget.Splitter.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height_large"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/settings_autobackup_choose" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/autoBackupNowButton"
                            style="@style/Widget.Splitter.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height_large"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/settings_autobackup_now" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Splitter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_data"
                            android:textAppearance="@style/Text.SectionLabel" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/exportAllButton"
                            style="@style/Widget.Splitter.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/menu_export_all" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/backupButton"
                            style="@style/Widget.Splitter.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/settings_backup" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/restoreButton"
                            style="@style/Widget.Splitter.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/settings_restore" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clearSuggestionsButton"
                            style="@style/Widget.Splitter.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/settings_clear_suggestions" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SPEC 7.14.5. Kept in its own card, away from everything reversible. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Splitter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    app:strokeColor="?attr/colorError">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_danger_zone"
                            android:textAppearance="@style/Text.SectionLabel"
                            android:textColor="?attr/colorError" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/wipeButton"
                            style="@style/Widget.Splitter.Button.Danger"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/settings_wipe" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--
                  The reader's own report. A card rather than a hidden gesture: it is only
                  ever opened on purpose, which is what "ad hoc" asked for, and a thing you
                  cannot find is not ad hoc, it is absent.
                -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Splitter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_l">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_parser_report"
                            android:textAppearance="@style/Text.SectionLabel" />

                        <TextView
                            android:id="@+id/parserReportSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:textAppearance="@style/Text.Caption" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/parserReportButton"
                            style="@style/Widget.Splitter.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/settings_parser_report_open" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SPEC 7.14.6 -->
                <TextView
                    android:id="@+id/aboutText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:textAppearance="@style/Text.Caption" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
